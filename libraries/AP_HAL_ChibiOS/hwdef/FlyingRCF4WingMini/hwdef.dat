# hw definition file for FlyingRC F4Wing Mini

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# bootloader starts firmware at 64k
FLASH_RESERVE_START_KB 64
FLASH_SIZE_KB 1024

# store parameters in pages 11 and 12
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_FlyingRCF4WingMini

define STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

# crystal frequency
OSCILLATOR_HZ 8000000


# --------------------- LED -----------------------
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PA14 LED0 OUTPUT LOW GPIO(90) # blue marked as ACT
PA13 LED1 OUTPUT LOW GPIO(91) # green marked as B/E
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90


# --------------------- PWM -----------------------
PC9  TIM8_CH4   TIM8  PWM(1)  GPIO(50)
PC8  TIM8_CH3   TIM8  PWM(2)  GPIO(51)
PB15 TIM1_CH3N  TIM1  PWM(3)  GPIO(52)
PA8  TIM1_CH1   TIM1  PWM(4)  GPIO(53)
PB11 TIM2_CH4   TIM2  PWM(5)  GPIO(54)
PB10 TIM2_CH3   TIM2  PWM(6)  GPIO(55)  # Only 6 PWMs on this board
PB1  TIM3_CH4   TIM3  PWM(7) GPIO(61)  # LED pad


# --------------------- SPI1 -----------------------
PA5  SPI1_SCK SPI1
PB4  SPI1_MISO SPI1
PA7  SPI1_MOSI SPI1

PC14 IMU_CS CS  # For ICM42605(HW_V1, HW_V3) or ICM42688P(HW_V2)


# -------------------- I2C bus --------------------
I2C_ORDER I2C1

PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

define HAL_I2C_INTERNAL_MASK 0

# --------------------- UARTs ---------------------------
SERIAL_ORDER OTG1 USART1 UART5 UART4

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1, Telem or CRSF
PA9  USART1_TX USART1 
PA10 USART1_RX USART1

# USART2
# alternative using USART2
# PA2 USART2_TX USART2 
# PA3 USART2_RX USART2  ALT(1)  # TX2, RX2 are not available on this board

# default to timer for RC input
PA3 TIM9_CH2 TIM9 RCININT PULLDOWN LOW  # SBUS input, integrated inverter on board

# UART4, for DJI
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# UART5, for GPS
PC12 UART5_TX UART5 NODMA
PD2  UART5_RX UART5 NODMA


# ------------------- DMA assignment -------------------
DMA_PRIORITY ADC1 SPI1* TIM1* TIM8* TIM3* UART2*


# ------------------- IMU ICM42605 ---------------------
SPIDEV icm42605  SPI1  DEVID1  IMU_CS  MODE3  2*MHZ  8*MHZ
IMU Invensensev3 SPI:icm42605 ROTATION_YAW_270
define HAL_DEFAULT_INS_FAST_SAMPLE 1


define HAL_LOGGING_ENABLED 0  # No onboard logging device

# ----------------- I2C compass & Baro -----------------
# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# built-in barometer
BARO SPL06  I2C:0:0x76
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_SPL06_ENABLED 1


# --------------------- ADC ---------------------------
PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 3  # Only monitor for analog voltage

define HAL_BATT_VOLT_PIN 14
define HAL_BATT_VOLT_SCALE 21.0


# --------------------- save flash ----------------------
# save some flash
include ../include/minimize_fpv_osd.inc
include ../include/no_bootloader_DFU.inc

define HAL_PARACHUTE_ENABLED 0
define HAL_RUNCAM_ENABLED 0
define HAL_BUTTON_ENABLED 0
define AP_NOTIFY_OREOLED_ENABLED 0

