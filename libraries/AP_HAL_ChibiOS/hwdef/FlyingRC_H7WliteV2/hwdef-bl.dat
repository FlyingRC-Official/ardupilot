# bootloader hw definition for FlyingRC H7Wlite V2

MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_FlyingRC_H7WliteV2
USB_STRING_PRODUCT "FlyingRC H7Wlite V2 BL"
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

SERIAL_ORDER OTG1 UART7
PE7 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PD10 PINIO1 OUTPUT LOW
PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

PC15 IMU1_CS CS
PB12 MAX7456_CS CS
PE11 IMU2_CS CS
PD4 EXT_CS1 CS
PE2 EXT_CS2 CS
PC13 IMU3_CS CS
